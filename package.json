{
  "name": "yard-sale-gold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "WRANGLER_CONFIG=wrangler.local.jsonc vite",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply yard-sale-gold-db --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply yard-sale-gold-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@openai/agents": "^0.17.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "barcode-detector": "3.2.2",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.125.0"
  }
}
