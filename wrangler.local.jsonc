// Local-only configuration for personal use: D1 and R2 live in .wrangler/state on this machine.
// It has no custom domain and no remote bindings, so it needs no Cloudflare account or token.
// Use it with `npm run dev:local` and `npm run db:migrate:local`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yard-sale-gold-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yard-sale-gold-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "bucket_name": "yard-sale-gold-thumbnails"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
