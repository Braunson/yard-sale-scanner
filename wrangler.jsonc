{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yard-sale-gold",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-24",
  "routes": [
    {
      "pattern": "yardsale.wesbos.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "remote": true,
      "database_name": "yard-sale-gold-db",
      "database_id": "ef692960-193c-4fb8-82ba-5ce9f1832988",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THUMBNAILS",
      "remote": true,
      "bucket_name": "yard-sale-gold-thumbnails"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
